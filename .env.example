# Create a long random value and set it in Vercel Production, Preview, and Development.
NEXA_PASSWORD=replace-with-a-long-random-password

# Vercel Postgres supplies POSTGRES_URL automatically after it is connected.
# For another managed PostgreSQL service, use DATABASE_URL instead.
# DATABASE_URL=postgresql://user:password@host:5432/nexa?sslmode=require

# Comma-separated origins only when hosting the web client on another domain.
# CORS_ORIGINS=https://nexa.example.com
